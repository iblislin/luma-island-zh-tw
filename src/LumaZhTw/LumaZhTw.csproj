<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LumaZhTw</AssemblyName>
    <RootNamespace>LumaZhTw</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <!-- Path to the game install. Override: dotnet build -p:GameDir="D:\...\Luma Island" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Luma Island</GameDir>
    <!-- A local, git-ignored copy of the game's Managed DLLs in GameRefs/ takes precedence -->
    <GameManaged Condition="Exists('$(MSBuildThisFileDirectory)..\..\GameRefs\Unity.Localization.dll')">$(MSBuildThisFileDirectory)..\..\GameRefs</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameDir)\Luma Island_Data\Managed</GameManaged>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Localization" HintPath="$(GameManaged)\Unity.Localization.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)\Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Dictionaries\*.txt" LogicalName="LumaZhTw.Dictionaries.%(Filename).txt" />
    <EmbeddedResource Include="Glossary.default.json" LogicalName="LumaZhTw.Glossary.default.json" />
  </ItemGroup>

  <!-- dotnet build -c Release -p:DeployToGame=true copies the plugin into BepInEx/plugins/LumaZhTw -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\LumaZhTw" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\fonts\NotoSansTC-Regular.otf;$(MSBuildThisFileDirectory)..\..\fonts\OFL.txt" DestinationFolder="$(GameDir)\BepInEx\plugins\LumaZhTw" />
  </Target>
</Project>
